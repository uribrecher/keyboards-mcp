{
  "name": "keyboards-mcp-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/keyboards-mcp",
    "packages/sounds-and-recreation-app"
  ],
  "scripts": {
    "build": "npm run build -w sounds-and-recreation-app",
    "lint": "npm run lint --workspaces --if-present",
    "test:check": "npm run test:check --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test": "npm run test -w keyboards-mcp",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0"
  }
}
