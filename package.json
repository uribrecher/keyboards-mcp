{
  "name": "keyboards-mcp",
  "version": "1.0.0",
  "description": "MCP server for controlling MIDI keyboards (Nord Electro 5D and more)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "mock:runner": "electron dist/mock-runner/main.js",
    "mock:headless": "tsx src/mock-runner/cli.ts",
"lint": "eslint src/ tests/",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "find tests/unit -name '*.test.ts' | xargs npx tsx --test",
    "test:integration": "find tests/integration -name '*.test.ts' | xargs npx tsx --test",
    "test:e2e": "find tests/e2e -name '*.test.ts' | xargs npx tsx --test --test-concurrency=1",
    "test:check": "tsc --noEmit -p tsconfig.test.json",
    "test:ci": "npm run lint && npm run test:check && npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "adm-zip": "^0.5.16",
    "easymidi": "^3.0.0",
    "ws": "^8.20.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "electron": "^41.1.1",
    "eslint": "^9.39.4",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.58.2"
  }
}
